# Keep the real file private (chmod 600). Do not put keys in source code.
GROQ_API_KEY=replace-with-your-key
GROQ_MODEL=qwen/qwen3.8-27b
HEYBOT_INPUT_DEVICE=auto
HEYBOT_OUTPUT_DEVICE=auto
HEYBOT_MODEL_PATH=/opt/heybot/models/vosk-model-small-en-us-0.15
HEYBOT_WEB_HOST=0.0.0.0
HEYBOT_WEB_PORT=8080
HEYBOT_HISTORY_LIMIT=500
HEYBOT_PHOTO_BUDGET_MB=200
# Set ALSA devices explicitly if needed, for example:
# HEYBOT_INPUT_DEVICE=plughw:CARD=Device,DEV=0
# HEYBOT_OUTPUT_DEVICE=plughw:CARD=Headphones,DEV=0
